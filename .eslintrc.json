{
  "env": {
    "browser": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 5,
    "sourceType": "script",
    "ecmaFeatures": {
      "globalReturn": true
    }
  },
  "globals": {
    "_": "readonly",
    "E": "readonly",
    "L": "readonly",
    "poll": "readonly",
    "request": "readonly",
    "baseclass": "readonly",
    "dom": "readonly",
    "form": "readonly",
    "fs": "readonly",
    "rpc": "readonly",
    "uci": "readonly",
    "ui": "readonly",
    "view": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-redeclare": "error",
    "no-constant-condition": "error",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-extra-semi": "error",
    "no-unreachable": "error",
    "eqeqeq": ["error", "smart"],
    "no-var": "off",
    "prefer-const": "off",
    "semi": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-restricted-syntax": [
      "error",
      { "selector": "ArrowFunctionExpression", "message": "ES5 only: use the function keyword, not arrow functions." },
      { "selector": "TemplateLiteral", "message": "ES5 only: use string concatenation, not template literals." },
      { "selector": "VariableDeclaration[kind='let']", "message": "ES5 only: use var, not let." },
      { "selector": "VariableDeclaration[kind='const']", "message": "ES5 only: use var, not const." },
      { "selector": "ClassDeclaration", "message": "ES5 only: no class syntax." },
      { "selector": "ClassExpression", "message": "ES5 only: no class syntax." },
      { "selector": "SpreadElement", "message": "ES5 only: no spread syntax." },
      { "selector": "RestElement", "message": "ES5 only: no rest parameters/destructuring." },
      { "selector": "ObjectPattern", "message": "ES5 only: no destructuring." },
      { "selector": "ArrayPattern", "message": "ES5 only: no destructuring." },
      { "selector": "CallExpression[callee.property.name='includes']", "message": "ES5 only: use indexOf(...) !== -1, not .includes()." },
      { "selector": "CallExpression[callee.object.name='Object'][callee.property.name='assign']", "message": "ES5 only: no Object.assign()." },
      { "selector": "UnaryExpression[operator='+']", "message": "Unary + is banned: a stray one in front of an E() child silently rendered NaN. Use Number(x) or parseInt(x, 10)." }
    ]
  }
}
