table netdev tm_ratelimit {
	set tctl_d_192_168_1_8 {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	set tctl_u_192_168_1_8 {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	chain dl_br_lan {
		ip daddr 192.168.1.5 limit rate over 625000 bytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_1_5"
		ip daddr 192.168.1.7 limit rate over 1000 kbytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_1_7"
		ip daddr 192.168.1.8 add @tctl_d_192_168_1_8 { ip daddr limit rate over 2000 kbytes/second } counter packets 0 bytes 0 drop
		ip daddr 192.168.1.4 limit rate over 1 mbytes/second counter packets 0 bytes 0 drop
		ip daddr 192.168.1.9 limit rate over 512 bytes/second counter packets 0 bytes 0 drop
	}

	chain ul_lan1 {
		ip saddr 192.168.1.5 limit rate over 125000 bytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_1_5_ul"
		ip saddr 192.168.1.8 add @tctl_u_192_168_1_8 { ip saddr limit rate over 250000 bytes/second } counter packets 0 bytes 0 drop
		ip saddr 192.168.1.60 limit rate over 125 kbytes/second counter packets 0 bytes 0 drop
	}
}
