table netdev tm_ratelimit {
	set tctl_m_10_0_20_0_24_dl_br_lan {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	set tctl_m_10_0_20_0_24_ul_lan1 {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	chain dl_br_lan {
		type filter hook egress device "br-lan" priority filter; policy accept;
		ip daddr 192.168.1.60 limit rate over 625000 bytes/second counter packets 7 bytes 900 drop comment "rl_ratelimit_192_168_1_60"
		ip daddr 10.0.20.0/24 add @tctl_m_10_0_20_0_24_dl_br_lan { ip daddr limit rate over 250000 bytes/second } counter packets 0 bytes 0 drop comment "rl_ratelimit_10_0_20_0_24"
	}

	chain ul_lan1 {
		type filter hook ingress device "lan1" priority -200; policy accept;
		ip saddr 192.168.1.60 limit rate over 125000 bytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_1_60_ul"
		ip saddr 10.0.20.0/24 add @tctl_m_10_0_20_0_24_ul_lan1 { ip saddr limit rate over 250000 bytes/second } counter packets 0 bytes 0 drop comment "rl_ratelimit_10_0_20_0_24_ul"
	}
}
