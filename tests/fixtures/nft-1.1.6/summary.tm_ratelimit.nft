table netdev tm_ratelimit {
	set tctl_d_192_168_0_113 {
		type ipv4_addr
		size 65535
		flags dynamic
	}

	chain dl_br_lan {
		ip daddr 192.168.0.140 limit rate over 625000 bytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_0_140"
		ip daddr 192.168.0.109 limit rate over 1000 kbytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_0_109"
		ip daddr 192.168.0.113 add @tctl_d_192_168_0_113 { ip daddr limit rate over 2 mbytes/second } counter packets 0 bytes 0 drop
	}

	chain ul_lan2 {
		ip saddr 192.168.0.140 limit rate over 125 kbytes/second counter packets 0 bytes 0 drop comment "rl_ratelimit_192_168_0_140_ul"
		ip saddr 192.168.0.210 limit rate over 3 mbytes/second drop
	}
}
