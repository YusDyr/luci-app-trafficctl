#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# shellcheck shell=dash
# Device watcher for the notification events (trafficctl.notify).
#
# new_device and known_device have no kernel event of their own: a device
# that keeps a static address or never asks for a lease shows up only in the
# neighbour table and the station lists. This loop scans them every
# notify.scan_interval seconds (`trafficctl notify watch`). The other events
# are emitted by the commands that cause them and need no service.
#
# The service runs only when something wants the scan (`trafficctl notify
# wanted`): notify.scan '1', or 'auto' (the default) with a sender subscribed
# to new_device or known_device, or a script in /etc/hotplug.d/trafficctl.
# Until 1.31 the Telegram bot ran this scan itself, so it stopped with the bot.
#
# START/STOP/USE_PROCD are consumed by the sourced /etc/rc.common framework.
# shellcheck disable=SC2034
START=96
STOP=10
USE_PROCD=1

start_service() {
	/usr/sbin/trafficctl notify wanted >/dev/null 2>&1 || return 0
	procd_open_instance notify
	procd_set_param command /usr/sbin/trafficctl notify watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# A sender switched on in the UI starts the watcher without a reboot.
	procd_add_reload_trigger "trafficctl"
}
