#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Prometheus scrape endpoint. Inert unless trafficctl.metrics.enabled=1.
#
# This serves device names, MACs and traffic volumes with no LuCI session, so
# it is disabled by default and requires a shared token once enabled:
#   uci set trafficctl.metrics.token=<secret>
#   scrape ...  /cgi-bin/trafficctl-metrics?token=<secret>
# An empty token is refused rather than read as "no auth": the shipped config
# has one, and enabling metrics alone must not publish the device list.
# Prefer also restricting the port to the LAN in your firewall.

TOKEN=$(uci -q get trafficctl.metrics.token 2>/dev/null)

deny() {
    printf 'Status: 403 Forbidden\r\n'
    printf 'Content-Type: text/plain\r\n\r\n'
    printf '%s\n' "$1"
    exit 0
}

[ "$(uci -q get trafficctl.metrics.enabled 2>/dev/null)" = "1" ] \
    || deny "trafficctl metrics disabled"

[ -n "$TOKEN" ] \
    || deny "trafficctl metrics token not set: uci set trafficctl.metrics.token=<secret>; uci commit trafficctl"

# QUERY_STRING is the only channel a stock Prometheus scrape config can use
# without custom headers.
case "&${QUERY_STRING}&" in
    *"&token=${TOKEN}&"*) ;;
    *) deny "invalid or missing token" ;;
esac

printf 'Content-Type: text/plain; version=0.0.4; charset=utf-8\r\n\r\n'
exec /usr/libexec/trafficctl/trafficctl-metrics.sh
